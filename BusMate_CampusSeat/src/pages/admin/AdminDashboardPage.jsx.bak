import React from 'react';
import { Link } from 'react-router-dom';
import { 
  Bus, Users, ShieldAlert, Clock, Activity, AlertTriangle, 
  Scale, LineChart, FileCode2, FlaskConical, Sliders, BarChart2, CheckCircle2, ArrowRight
} from 'lucide-react';
import busesData from '../../data/buses.json';
import { getFleetRecommendations } from '../../services/fleetService';

export const AdminDashboardPage = () => {
  const activeBusesCount = busesData.length;
  const highRiskTripsCount = busesData.filter(b => b.riskLevel === 'High').length;
  const delayedBusesCount = busesData.filter(b => b.status.includes('delay')).length;
  const recommendations = getFleetRecommendations();
  const pendingRecsCount = recommendations.filter(r => r.status === 'Pending').length;

  const kpis = [
    { title: 'Active Bus Fleet', value: activeBusesCount, sub: 'Operating in transit', icon: Bus, color: 'bg-sky-800 text-white' },
    { title: 'Total Passenger Requests', value: 73, sub: 'Peak 5:00 PM slot', icon: Users, color: 'bg-teal-700 text-white' },
    { title: 'High-Risk Overcrowded Trips', value: highRiskTripsCount, sub: 'Risk ≥ 70%', icon: ShieldAlert, color: 'bg-red-700 text-white' },
    { title: 'Delayed Vehicles', value: delayedBusesCount, sub: 'Avg +4 mins delay', icon: Clock, color: 'bg-amber-700 text-white' },
    { title: 'Average Capacity Occupancy', value: '74%', sub: 'Bus fleet utilization', icon: Activity, color: 'bg-slate-900 text-white' },
    { title: 'Unfulfilled Priority Requests', value: 1, sub: 'Wheelchair / Accessibility', icon: AlertTriangle, color: 'bg-purple-800 text-white' },
    { title: 'Current System Fairness Index', value: '91 / 100', sub: 'Calibrated Pareto score', icon: Scale, color: 'bg-emerald-800 text-white' },
    { title: 'Pending Fleet Action Recs', value: pendingRecsCount, sub: 'Requires admin action', icon: CheckCircle2, color: 'bg-indigo-800 text-white' }
  ];

  const modules = [
    { path: '/admin/demand', name: 'Demand Prediction', desc: 'Predict passenger volume by weather, time, & event', icon: LineChart },
    { path: '/admin/overcrowding', name: 'Overcrowding Risk Model', desc: 'Multi-factor risk probability classification', icon: ShieldAlert },
    { path: '/admin/xai', name: 'XAI & SHAP Explanations', desc: 'Feature attributions in simple & technical views', icon: FileCode2 },
    { path: '/admin/allocation', name: 'Capacity Allocation Manager', desc: 'Hard constraints & score weight execution', icon: Scale },
    { path: '/admin/counterfactual', name: 'Counterfactual Fairness Lab', desc: 'Single-attribute passenger perturbation tests', icon: FlaskConical },
    { path: '/admin/batch-eval', name: 'Batch Fairness Evaluation', desc: 'Seeded simulation over 1,000–5,000 scenarios', icon: Activity },
    { path: '/admin/calibration', name: 'Policy Weight Calibration', desc: 'Tune sliders & simulate candidate policy vectors', icon: Sliders },
    { path: '/admin/tradeoff', name: 'Fairness–Efficiency Trade-off', desc: 'Interactive scatter plot & Pareto knee-point', icon: BarChart2 },
    { path: '/admin/baselines', name: 'Policy Baselines Comparison', desc: 'Compare FCFS, Random, & SmartBus Policy', icon: Scale },
    { path: '/admin/recommendations', name: 'Intelligent Fleet Recommendations', desc: 'Accept or reject standby bus deployment', icon: Bus },
    { path: '/admin/hci-eval', name: 'HCI 2×2 Evaluation Module', desc: 'Simulated user trust & perceived fairness metrics', icon: Users }
  ];

  return (
    <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-10">
      
      {/* Header */}
      <div className="bg-slate-900 text-white border-2 border-slate-800 rounded-2xl p-8 shadow-xl flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <div>
          <span className="text-xs font-mono font-bold text-teal-400 uppercase tracking-widest">Administrator & Researcher Control Portal</span>
          <h1 className="text-3xl font-black tracking-tight mt-1">SmartBus Intelligence Center</h1>
          <p className="text-xs text-slate-300 mt-1 max-w-2xl">
            Integrates demand prediction, SHAP explainable ML, counterfactual fairness analysis, and policy calibration.
          </p>
        </div>

        <Link
          to="/admin/recommendations"
          className="px-4 py-2.5 bg-teal-600 text-white font-extrabold text-xs rounded-xl hover:bg-teal-700 transition-colors shadow flex items-center gap-2"
        >
          <span>Pending Recs ({pendingRecsCount})</span>
          <ArrowRight className="w-4 h-4" />
        </Link>
      </div>

      {/* KPI Cards Grid */}
      <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {kpis.map((kpi, idx) => {
          const IconComp = kpi.icon;
          return (
            <div key={idx} className="bg-white rounded-2xl border-2 border-slate-300 p-5 shadow-sm space-y-3">
              <div className="flex justify-between items-center">
                <span className="text-xs font-bold text-slate-600 uppercase">{kpi.title}</span>
                <div className={`w-9 h-9 rounded-lg ${kpi.color} flex items-center justify-center`}>
                  <IconComp className="w-5 h-5" />
                </div>
              </div>
              <div className="text-3xl font-black text-slate-900">{kpi.value}</div>
              <div className="text-xs text-slate-500 font-semibold">{kpi.sub}</div>
            </div>
          );
        })}
      </div>

      {/* Admin Modules Navigation Grid */}
      <div className="space-y-6">
        <div className="flex justify-between items-center">
          <h2 className="text-2xl font-black text-slate-900">Research & Operational Control Modules</h2>
          <span className="text-xs font-bold text-slate-500">11 Modules Available</span>
        </div>

        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {modules.map((mod, idx) => {
            const IconComp = mod.icon;
            return (
              <Link
                key={idx}
                to={mod.path}
                className="bg-white border-2 border-slate-300 rounded-2xl p-6 shadow-sm hover:shadow-md hover:border-sky-800 transition-all space-y-3 group"
              >
                <div className="w-12 h-12 rounded-xl bg-slate-100 group-hover:bg-sky-800 text-slate-800 group-hover:text-white flex items-center justify-center transition-colors">
                  <IconComp className="w-6 h-6" />
                </div>
                <h3 className="text-lg font-black text-slate-900 group-hover:text-sky-900 transition-colors">
                  {mod.name}
                </h3>
                <p className="text-xs text-slate-600 font-medium leading-relaxed">
                  {mod.desc}
                </p>
                <div className="pt-2 text-xs font-extrabold text-sky-800 flex items-center gap-1">
                  <span>Open Module</span>
                  <ArrowRight className="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
                </div>
              </Link>
            );
          })}
        </div>
      </div>

    </div>
  );
};
